{
  "name": "metdx-demo-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && node scripts/build-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --project=mock-ol --grep @quick",
    "e2e:full": "playwright test --project=mock-ol",
    "e2e:leaflet": "E2E_LEAFLET=1 playwright test --project=mock-ol --project=mock-leaflet",
    "e2e:live": "E2E_LIVE=1 playwright test --project=live --workers=1"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@geoman-io/leaflet-geoman-free": "^2.20.5",
    "@mui/icons-material": "^6.1.10",
    "@mui/material": "^6.1.10",
    "covjson-reader": "^0.16.3",
    "d3-contour": "^4.0.2",
    "d3-delaunay": "^6.0.4",
    "leaflet": "^1.9.4",
    "leaflet-coverage": "^0.9.1",
    "ol": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
